+class ZNorm:
+    """Picklable z-score normaliser (closures cannot cross Windows' spawn-based DataLoader workers)."""
+
+    def __init__(self, mean, std, fill_nan: bool = True):
+        self.mean, self.std, self.fill_nan = mean, std, fill_nan
+
+    def __call__(self, x):
+        x = (x - self.mean) / self.std
+        if self.fill_nan:
+            x = torch.nan_to_num(x, nan=0.0, posinf=0.0, neginf=0.0)
+        return x.float()
+
