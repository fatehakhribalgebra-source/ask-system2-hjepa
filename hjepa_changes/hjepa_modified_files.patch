index dd00289..c7d9393 100644
--- a/h_jepa/loss.py
+++ b/h_jepa/loss.py
@@ -47,6 +47,33 @@ class SIGReg(torch.nn.Module):
         return statistic.mean()
 
 
+class SVReg(torch.nn.Module):
+    """Sliced variance regularisation (Ren et al. 2026, Content-Geometry tradeoff): a one-sided floor on the standard
+    deviation of the latent along random unit directions, R = E_u[max(0, floor - std(z . u))^2]. Unlike SIGReg it
+    does not push the latent toward an isotropic Gaussian, so a smooth map of the state can form."""
+
+    def __init__(self, num_proj=256, floor=1.0):
+        super().__init__()
+        self.num_proj, self.floor = int(num_proj), float(floor)
+
+    def forward(self, z):
+        """z: (..., D); statistics over every leading position (batch and time)."""
+        z = z.reshape(-1, z.size(-1)).float()
+        U = torch.randn(z.size(-1), self.num_proj, device=z.device)
+        U = U / U.norm(dim=0, keepdim=True)
+        return F.relu(self.floor - (z @ U).std(0)).square().mean()
+
+
+def slowness(z, frac=0.125):
+    """Variance-normalised slowness on a fixed set of 'slow channels' (the first frac of dims), Slow SVReg eq. (2):
+    E_t ||b_{t+1} - b_t||^2 / tr Var(b). z: (B, T, D) with T >= 2."""
+    k = max(1, int(round(frac * z.size(-1))))
+    b = z[..., :k].float()
+    num = (b[:, 1:] - b[:, :-1]).square().sum(-1).mean()
+    den = b.reshape(-1, k).var(0).sum() + 1e-6
+    return num / den
+
+
